{
  "version": 1,
  "defaults": {
    "auth": { "mode": "none" },
    "timeouts": { "responseMs": 5000, "firstByteMs": 30000, "bodyMs": 300000 },
    "maxBodyBytes": 10485760
  },
  "trustedProxies": ["127.0.0.1/32", "::1/128"],
  "routes": [
    {
      "id": "gantry",
      "match": { "host": "admin.example.com", "path": "/", "methods": ["GET"] },
      "upstream": "http://gantry:3000",
      "auth": { "mode": "session" },
      "accessCheck": true,
      "accessStaleGraceMs": 300000,
      "crossSite": "strict",
      "forwardAuthorization": false
    },
    {
      "id": "gantry-admin",
      "match": {
        "host": "admin.example.com",
        "path": "/",
        "methods": ["POST", "PUT", "DELETE"]
      },
      "upstream": "http://gantry:3000",
      "auth": { "mode": "session" },
      "accessCheck": true,
      "crossSite": "strict",
      "forwardAuthorization": false
    }
  ]
}
