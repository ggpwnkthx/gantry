{
  "name": "gantry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Gantry: the operator console of Shuttle and Hub.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggpwnkthx/gantry.git"
  },
  "scripts": {
    "dev": "bunx --bun vite",
    "dev:stack": "bun run scripts/dev-stack.ts",
    "build": "vite build --mode client && vite build",
    "start": "cd dist && bun index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "dead": "knip",
    "test": "bun test && bun run scripts/check-client-bundle.ts",
    "test:browser": "playwright test",
    "test:stack": "playwright test -c playwright.stack.config.ts"
  },
  "dependencies": {
    "hono": "4.13.13",
    "honox": "0.1.62",
    "jose": "6.2.12",
    "preact": "10.29.8",
    "preact-render-to-string": "6.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@hono/vite-build": "1.11.1",
    "@hono/vite-dev-server": "0.26.1",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@types/bun": "1.4.3",
    "knip": "6.42.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
